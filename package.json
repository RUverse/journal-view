{
	"name": "journal-view",
	"version": "1.1.3-beta.0",
	"description": "Journal View - a continuous, scrollable journal view of your daily notes for Obsidian.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"test-vault": "bash scripts/setup-test-vault.sh",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"journal",
		"daily-notes"
	],
	"author": "RUverse",
	"license": "MIT",
	"homepage": "https://github.com/RUverse/journal-view#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RUverse/journal-view.git"
	},
	"bugs": {
		"url": "https://github.com/RUverse/journal-view/issues"
	},
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^9.39.4",
		"@types/node": "^20.11.0",
		"esbuild": "^0.20.0",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"obsidian": "^1.5.7",
		"tslib": "^2.6.2",
		"typescript": "^5.3.3",
		"typescript-eslint": "^8.59.1"
	}
}
